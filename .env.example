# Copy this file to `.env` and fill it in. `.env` is gitignored: never commit keys.

# Server only: the chat endpoint (`src/routes/api/chat`) calls models through OpenRouter.
# Create a key in your OpenRouter account settings.
OPENROUTER_API_KEY=

# Optional. When the chat answers with a labelled mock reply instead of a real model:
#   off      - never (the default in production)
#   fallback - when OpenRouter rate-limits a request (the default in dev)
#   always   - every request; OpenRouter isn't called and no key is needed
# MOCK_LLM=fallback
